# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# sensitive keys
keys/

# old next-pwa output (public/sw.js is now hand-written and tracked)
/public/workbox-*.js

# local scratch scripts (may contain keys — never commit)
/scratch/
/test-*.ts
/test-*.js

# playwright
/e2e/playwright-report/
/e2e/test-results/
/playwright-report/
/test-results/

# wrangler dev local state
.wrangler/
