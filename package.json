{
  "name": "docsync-ai",
  "version": "0.1.0",
  "description": "Photograph paper business documents and turn them into rows in Google Sheets and Notion.",
  "homepage": "https://docsync.analogdigital.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/shoubhiksaha/docsync-ai.git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test -c e2e/playwright.config.ts smoke.spec ux.spec",
    "test:contract": "playwright test -c e2e/playwright.config.ts contract.spec",
    "check:conflicts": "bash scripts/check-conflict-markers.sh",
    "check:secrets": "bash scripts/check-secrets.sh",
    "promote": "bash scripts/promote-to-main.sh",
    "setup:hooks": "git config core.hooksPath scripts/git-hooks"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.2",
    "@upstash/redis": "^1.38.0",
    "firebase-admin": "^14.5.0",
    "googleapis": "^173.0.0",
    "lucide-react": "1.51.0",
    "next": "^15.5.28",
    "next-auth": "^4.24.15",
    "notion-multipart-uploader": "^2.3.0",
    "openai": "^6.49.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "eslint-config-next": "^15.5.28",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "overrides": {
    "jose": "5.9.6",
    "jwks-rsa": "3.1.0",
    "protobufjs": "^7.2.5",
    "postcss": "^8.4.31"
  },
  "engines": {
    "node": ">=20"
  }
}
